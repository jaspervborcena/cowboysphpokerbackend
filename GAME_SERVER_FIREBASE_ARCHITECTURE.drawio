        <mxCell id="pots" value="NLH Pot + Outcome Resolver&lt;br&gt;side pots · ties · uncalled returns · gross awards" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#274E13;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1060" y="315" width="330" height="78" as="geometry"/></mxCell>
        <mxCell id="transitionStore" value="Firestore Checkpoint + Action Journal (partial)&lt;br&gt;lease/sequence fenced for implemented actions + buy-ins&lt;br&gt;REST/settings/lifecycle gaps remain" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="475" width="360" height="88" as="geometry"/></mxCell>
        <mxCell id="project2" value="Per-player Snapshot Projection&lt;br&gt;complete snapshots · masked hole cards" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#274E13;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1000" y="475" width="270" height="88" as="geometry"/></mxCell>
        <mxCell id="reconnect" value="Reconnect&lt;br&gt;re-authenticate + load latest checkpoint snapshot&lt;br&gt;event cursor / journal replay pending" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1300" y="475" width="250" height="88" as="geometry"/></mxCell>

        <mxCell id="intent" value="Completed Hand&lt;br&gt;restricted audit + pending settlement_status&lt;br&gt;no separate settlement intent/outbox" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="645" width="310" height="86" as="geometry"/></mxCell>
        <mxCell id="settleWorker" value="In-process Settlement + Startup Retry&lt;br&gt;idempotent repository transaction&lt;br&gt;separate durable worker pending" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="440" y="645" width="300" height="86" as="geometry"/></mxCell>
        <mxCell id="atomicSettlement" value="Firestore Transaction&lt;br&gt;create unique ledger movement docs + update balances&lt;br&gt;mark intent/hand settled atomically; duplicate is no-op" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#274E13;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="810" y="645" width="360" height="86" as="geometry"/></mxCell>
        <mxCell id="outbox" value="Firestore Outbox + Workers&lt;br&gt;durable notifications, reconciliation, retryable jobs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1F4E79;fontSize=12;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1240" y="645" width="300" height="86" as="geometry"/></mxCell>

        <mxCell id="crash" value="Worker fails / lease expires" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#7A1F1F;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="865" width="210" height="68" as="geometry"/></mxCell>
        <mxCell id="newOwner" value="New owner claims after expiry&lt;br&gt;Firestore increments fencing generation (implemented)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="865" width="260" height="68" as="geometry"/></mxCell>
        <mxCell id="loadState" value="Restore latest checkpoint&lt;br&gt;journal replay / full crash recovery validation pending" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="610" y="865" width="270" height="68" as="geometry"/></mxCell>
        <mxCell id="timerRecover" value="Restore persisted deadline&lt;br&gt;only current fenced owner may fire timeout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1F4E79;fontSize=12;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="930" y="865" width="285" height="68" as="geometry"/></mxCell>
        <mxCell id="resume2" value="Resume actor&lt;br&gt;send fresh authorized snapshot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1F4E79;fontSize=12;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1265" y="865" width="260" height="68" as="geometry"/></mxCell>
        <mxCell id="tournamentClock" value="Tournament Clock (separate authority)&lt;br&gt;durable level/deadline; sends AdvanceBlinds via directory/bus&lt;br&gt;table actors do not independently advance blind levels" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1F4E79;fontSize=12;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="430" y="1020" width="670" height="78" as="geometry"/></mxCell>
        <mxCell id="safetyNote" value="Firestore design note: keep immutable per-event documents, bounded checkpoints, and deterministic idempotency keys; load-test transaction contention, index cost, lease renewal, and recovery. Never persist or expose an unrevealed raw RNG seed." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#7F6000;" vertex="1" parent="1"><mxGeometry x="40" y="1120" width="1510" height="45" as="geometry"/></mxCell>

