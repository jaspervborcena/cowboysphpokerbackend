  <diagram id="firebase-flow" name="Commands Settlement and Recovery">
    <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title2" value="Commands, Firestore Settlement, Reconnect, and Recovery" style="text;html=1;align=left;verticalAlign=middle;fontSize=23;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="42" as="geometry"/></mxCell>
        <mxCell id="note2" value="Firestore is authoritative. The target engine is first-party; current NLH still depends on PokerKit until the replacement is tested. Never let stale owners or WebSocket handlers apply balances directly." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#42526E;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1200" height="30" as="geometry"/></mxCell>

        <mxCell id="clientAction" value="Client Action&lt;br&gt;client_request_id · action_id · expected_state_version" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#274E13;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="35" y="145" width="245" height="72" as="geometry"/></mxCell>
        <mxCell id="gateway2" value="WebSocket Gateway&lt;br&gt;verify auth · per-action rate limit · validate message" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="315" y="145" width="260" height="72" as="geometry"/></mxCell>
        <mxCell id="dir2" value="Table Directory&lt;br&gt;resolve current worker + fencing generation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1F4E79;fontSize=12;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="610" y="145" width="250" height="72" as="geometry"/></mxCell>
        <mxCell id="bus2" value="Pub/Sub Command Forwarding&lt;br&gt;key/order by table_id; retries are deduplicated by actor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1F4E79;fontSize=12;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="895" y="145" width="270" height="72" as="geometry"/></mxCell>
        <mxCell id="actor2" value="Authoritative Table Actor&lt;br&gt;one mailbox; dedup client_request_id/action_id; check version and lease token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1F4E79;fontSize=12;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1200" y="145" width="350" height="72" as="geometry"/></mxCell>

        <mxCell id="rules" value="Variant Rules + State Transition&lt;br&gt;legal action -> next authoritative state/events" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1F4E79;fontSize=12;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="50" y="315" width="285" height="78" as="geometry"/></mxCell>
        <mxCell id="rng" value="Secure RNG + Deck/Dealer&lt;br&gt;CSPRNG in production; deterministic injection in tests&lt;br&gt;restricted commitment/hash audit; never public seed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1F4E79;fontSize=11;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="385" y="315" width="325" height="78" as="geometry"/></mxCell>
        <mxCell id="eval" value="Hand Evaluator&lt;br&gt;variant-specific ranking" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1F4E79;fontSize=12;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="760" y="315" width="250" height="78" as="geometry"/></mxCell>
        <mxCell id="pots" value="Pot + Outcome Resolver&lt;br&gt;eligibility · side pots · ties · gross awards" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1F4E79;fontSize=12;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1060" y="315" width="330" height="78" as="geometry"/></mxCell>
        <mxCell id="transitionStore" value="Fenced Firestore Commit&lt;br&gt;accepted event + state version/checkpoint&lt;br&gt;validate fencing generation; avoid hot single-doc writes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#274E13;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="475" width="360" height="88" as="geometry"/></mxCell>
        <mxCell id="project2" value="Per-player Projection&lt;br&gt;mask cards; event cursor = last_event_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1F4E79;fontSize=12;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1000" y="475" width="270" height="88" as="geometry"/></mxCell>
        <mxCell id="reconnect" value="Reconnect&lt;br&gt;client resumes after last_event_id&lt;br&gt;replay authorized durable events, then live stream" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1F4E79;fontSize=12;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1300" y="475" width="250" height="88" as="geometry"/></mxCell>

        <mxCell id="intent" value="Completed Hand&lt;br&gt;restricted audit + pending Settlement Intent&lt;br&gt;deterministic hand_id / settlement_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="645" width="310" height="86" as="geometry"/></mxCell>
        <mxCell id="settleWorker" value="Settlement Worker&lt;br&gt;claims pending intent; retries safely&lt;br&gt;not the table actor or WebSocket handler" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1F4E79;fontSize=12;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="440" y="645" width="300" height="86" as="geometry"/></mxCell>
        <mxCell id="atomicSettlement" value="Firestore Transaction&lt;br&gt;create unique ledger movement docs + update balances&lt;br&gt;mark intent/hand settled atomically; duplicate is no-op" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#274E13;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="810" y="645" width="360" height="86" as="geometry"/></mxCell>
        <mxCell id="outbox" value="Firestore Outbox + Workers&lt;br&gt;durable notifications, reconciliation, retryable jobs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1F4E79;fontSize=12;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1240" y="645" width="300" height="86" as="geometry"/></mxCell>

        <mxCell id="crash" value="Worker fails / lease expires" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#7A1F1F;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="865" width="210" height="68" as="geometry"/></mxCell>
        <mxCell id="newOwner" value="New owner acquires lease&lt;br&gt;increments fencing generation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1F4E79;fontSize=12;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="300" y="865" width="260" height="68" as="geometry"/></mxCell>
        <mxCell id="loadState" value="Load checkpoint + events&lt;br&gt;validate hand and settlement status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#274E13;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="610" y="865" width="270" height="68" as="geometry"/></mxCell>
        <mxCell id="timerRecover" value="Restore persisted deadline&lt;br&gt;only current fenced owner may fire timeout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1F4E79;fontSize=12;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="930" y="865" width="285" height="68" as="geometry"/></mxCell>
        <mxCell id="resume2" value="Resume actor&lt;br&gt;send fresh authorized snapshot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1F4E79;fontSize=12;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1265" y="865" width="260" height="68" as="geometry"/></mxCell>
        <mxCell id="tournamentClock" value="Tournament Clock (separate authority)&lt;br&gt;durable level/deadline; sends AdvanceBlinds via directory/bus&lt;br&gt;table actors do not independently advance blind levels" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1F4E79;fontSize=12;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="430" y="1020" width="670" height="78" as="geometry"/></mxCell>
        <mxCell id="safetyNote" value="Firestore design note: keep immutable per-event documents, bounded checkpoints, and deterministic idempotency keys; load-test transaction contention, index cost, lease renewal, and recovery. Never persist or expose an unrevealed raw RNG seed." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#7F6000;" vertex="1" parent="1"><mxGeometry x="40" y="1120" width="1510" height="45" as="geometry"/></mxCell>

