        <mxCell id="pokerEngines" value="First-Party Poker Engine&lt;br&gt;NLH first&lt;br&gt;PLO family after NLH is stable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1F4E79;fontSize=12;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="580" y="785" width="245" height="72" as="geometry"/></mxCell>
        <mxCell id="tongits" value="Tongits Engine&lt;br&gt;independent rules, state, and scoring" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1F4E79;fontSize=12;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="860" y="785" width="250" height="72" as="geometry"/></mxCell>
        <mxCell id="tournament" value="Tournament Service + Clock&lt;br&gt;registration · blind levels · eliminations · balancing&lt;br&gt;sends commands; does not implement hand rules" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1F4E79;fontSize=12;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1145" y="875" width="360" height="72" as="geometry"/></mxCell>

        <mxCell id="firestore" value="Cloud Firestore | durable business authority&lt;br&gt;balances + ledger entries · hand audits · settlement intents/outbox&lt;br&gt;table leases · event records · checkpoints (partitioned; contention-tested)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#274E13;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="70" y="960" width="520" height="100" as="geometry"/></mxCell>
        <mxCell id="settlementWorker" value="Settlement / Durable Job Workers&lt;br&gt;claim pending intents · retry idempotently&lt;br&gt;Firestore transactions; no direct WS balance writes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1F4E79;fontSize=12;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="660" y="960" width="350" height="100" as="geometry"/></mxCell>
        <mxCell id="redis" value="Redis (optional)&lt;br&gt;ephemeral presence / cache only&lt;br&gt;not ownership, balances, or game-state authority" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#5B3B66;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1080" y="960" width="290" height="100" as="geometry"/></mxCell>
        <mxCell id="observability" value="Monitoring + Admin Controls&lt;br&gt;mailbox depth · command latency · timer drift · lease renewals&lt;br&gt;metrics · traces · alerts · reconciliation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1F4E79;fontSize=12;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1410" y="950" width="170" height="120" as="geometry"/></mxCell>
        <mxCell id="scaleNote" value="Firestore is retained to match the current platform. Avoid one hot table document for every action; shard event records and validate lease/checkpoint contention, quotas, cost, recovery time, and 1k-10k load before calling this production-ready." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#7F6000;" vertex="1" parent="1"><mxGeometry x="65" y="1090" width="1500" height="50" as="geometry"/></mxCell>

