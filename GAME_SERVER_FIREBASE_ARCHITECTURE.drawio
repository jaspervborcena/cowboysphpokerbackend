        <mxCell id="abuse" value="Abuse Controls&lt;br&gt;per-player/table limits · account risk signals · audit review" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1F4E79;fontSize=12;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1210" y="310" width="335" height="82" as="geometry"/></mxCell>

        <mxCell id="bus" value="Command + Event Bus&lt;br&gt;Google Pub/Sub target; order by table_id where required&lt;br&gt;delivery is not game-state authority" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1F4E79;fontSize=13;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="480" y="445" width="390" height="82" as="geometry"/></mxCell>
        <mxCell id="directory" value="Table Directory + Ownership&lt;br&gt;Firestore table lease · expiry · fencing generation&lt;br&gt;route table_id to current owner" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1F4E79;fontSize=13;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1020" y="435" width="400" height="92" as="geometry"/></mxCell>

        <mxCell id="runtimeBoundary" value="GAME RUNTIME CLUSTER | single authoritative actor per table" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F9FC;fillOpacity=35;strokeColor=#6C8EBF;strokeWidth=2;dashed=1;fontColor=#1F4E79;fontSize=15;fontStyle=1;verticalAlign=top;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="55" y="570" width="1490" height="120" as="geometry"/></mxCell>
        <mxCell id="workerA" value="Cloud Run Runtime Worker A&lt;br&gt;table actors · serialized mailbox · turn deadlines" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1F4E79;fontSize=13;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="170" y="610" width="500" height="62" as="geometry"/></mxCell>
        <mxCell id="workerB" value="Cloud Run Runtime Worker B&lt;br&gt;table actors · serialized mailbox · recovery" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1F4E79;fontSize=13;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="920" y="610" width="500" height="62" as="geometry"/></mxCell>

        <mxCell id="engineBoundary" value="FIRST-PARTY GAME ENGINE | no FastAPI, network, external poker engine, or Firestore dependencies" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F9FC;fillOpacity=35;strokeColor=#6C8EBF;strokeWidth=2;dashed=1;fontColor=#1F4E79;fontSize=15;fontStyle=1;verticalAlign=top;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="55" y="720" width="1490" height="145" as="geometry"/></mxCell>
        <mxCell id="engineInterface" value="Engine Interface&lt;br&gt;typed command · state transition · outcome" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1F4E79;fontSize=12;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="80" y="785" width="225" height="72" as="geometry"/></mxCell>
