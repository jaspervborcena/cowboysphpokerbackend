        <mxCell id="title2" value="Commands, Firestore Settlement, Reconnect, and Recovery" style="text;html=1;align=left;verticalAlign=middle;fontSize=23;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="42" as="geometry"/></mxCell>
        <mxCell id="note2" value="Firestore-backed leases/checkpoints and opt-in WebSocket Pub/Sub/Redis routing are implemented; gateway/worker services are not deployed. REST routing, full replay/failover, emulator verification, and load validation remain." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#42526E;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1200" height="30" as="geometry"/></mxCell>

        <mxCell id="clientAction" value="Client Action&lt;br&gt;action_id retry supported; no expected state version" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="35" y="145" width="245" height="72" as="geometry"/></mxCell>
        <mxCell id="gateway2" value="WebSocket Gateway (opt-in split)&lt;br&gt;verify auth · validate · route player/pre-actions&lt;br&gt;Redis presence routes masked snapshots" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="315" y="145" width="260" height="72" as="geometry"/></mxCell>
        <mxCell id="dir2" value="Firestore Table Directory&lt;br&gt;durable worker session + scoped table lease&lt;br&gt;owner + fencing generation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="610" y="145" width="250" height="72" as="geometry"/></mxCell>
        <mxCell id="bus2" value="Pub/Sub (opt-in code)&lt;br&gt;ordered WebSocket command + reply/event transport&lt;br&gt;Firestore journal handles implemented action dedup" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="895" y="145" width="270" height="72" as="geometry"/></mxCell>
        <mxCell id="actor2" value="Table Runtime (lease owner)&lt;br&gt;per-table lock · checkpointed action paths&lt;br&gt;REST routing / full replay pending" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1200" y="145" width="350" height="72" as="geometry"/></mxCell>

        <mxCell id="rules" value="First-Party NLH Rules + State Transition&lt;br&gt;legal action -> next authoritative state/events" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#274E13;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="315" width="285" height="78" as="geometry"/></mxCell>
        <mxCell id="rng" value="Secure RNG + Deck/Dealer&lt;br&gt;CSPRNG in production; deterministic injection in tests" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#274E13;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="385" y="315" width="325" height="78" as="geometry"/></mxCell>
