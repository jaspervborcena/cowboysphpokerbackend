  <diagram id="firebase-overview" name="Firebase Production Target">
    <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="Firebase / Firestore Game Server | Production Target" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="42" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Selected stack: Firebase Auth + Firestore. Current NLH still uses PokerKit; target is a first-party engine with no PokerKit dependency. Scale remains unverified." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#42526E;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1220" height="30" as="geometry"/></mxCell>
        <mxCell id="legCurrent" value="Exists today" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#274E13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1110" y="25" width="120" height="34" as="geometry"/></mxCell>
        <mxCell id="legPartial" value="Partial / coupled" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1245" y="25" width="150" height="34" as="geometry"/></mxCell>
        <mxCell id="legTarget" value="Target" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1F4E79;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1410" y="25" width="120" height="34" as="geometry"/></mxCell>

        <mxCell id="clients" value="Game Clients&lt;br&gt;Web · Mobile · Lobby · Table UI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#274E13;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="600" y="110" width="400" height="64" as="geometry"/></mxCell>
        <mxCell id="loadbalancer" value="HTTPS / WebSocket Load Balancer&lt;br&gt;TLS · health checks · routing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1F4E79;fontSize=13;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="600" y="205" width="400" height="64" as="geometry"/></mxCell>
        <mxCell id="rest" value="REST API Replicas&lt;br&gt;session · lobby · table control" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="130" y="320" width="270" height="72" as="geometry"/></mxCell>
        <mxCell id="gateway" value="WebSocket Gateway Replicas&lt;br&gt;auth · schemas · action rate limits · delivery" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="465" y="320" width="330" height="72" as="geometry"/></mxCell>
